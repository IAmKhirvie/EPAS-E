APP_NAME="Hasa"
APP_ENV=local
APP_KEY= # Generate with: php artisan key:generate --show
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ============================================================================
# HTTPS / SSL Configuration
# ============================================================================
# LOCAL DEVELOPMENT:
#   FORCE_HTTPS=false
#   TRUSTED_PROXIES=
#
# CLOUDFLARE TUNNEL (auto-detects X-Forwarded-Proto):
#   FORCE_HTTPS=false
#   TRUSTED_PROXIES=*
#
# PRODUCTION WITH REVERSE PROXY:
#   FORCE_HTTPS=true
#   TRUSTED_PROXIES=<your-proxy-ips> (or IPs of Cloudflare, etc.)
#
FORCE_HTTPS=false # Set to true in production behind a reverse proxy that terminates SSL (e.g., Cloudflare, Nginx) to ensure correct URL generation and secure cookies.
TRUSTED_PROXIES= # Use '*' for Cloudflare tunnel, specific IPs for production reverse proxy, or leave empty for local development without proxies.

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================================
# Database Configuration
# ============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hasa
DB_USERNAME=root
DB_PASSWORD= # Set your local database password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false # Set to true in production to encrypt session data in the database
SESSION_SECURE_COOKIE=false # Set to true in production to ensure cookies are only sent over HTTPS
SESSION_PATH=/ # Set to '/' for local development, adjust in production if needed (e.g., '/app' if your app is served from a subdirectory)
SESSION_DOMAIN= # Set to your domain in production to allow cookies across subdomains

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# ============================================================================
# Redis (optional – for production caching/queues)
# ============================================================================
REDIS_CLIENT=phpredis # Use 'predis' if you prefer a pure PHP implementation, or 'phpredis' for better performance (requires PHP extension)
REDIS_HOST=127.0.0.1 # Set to your Redis server IP or hostname in production
REDIS_PASSWORD=null # Set to your Redis password if applicable
REDIS_PORT=6379

# ============================================================================
# Mail Configuration (SMTP)
# ============================================================================
# For Gmail: Enable 2-Step Verification → Generate App Password
# For other providers: Adjust host, port, encryption accordingly
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com # Set to your Gmail address or SMTP username
MAIL_PASSWORD="your-app-password" # Use an app password generated from your Google Account for better security
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com # Set to your desired "from" email address
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================================
# AWS (optional – for S3 storage)
# ============================================================================
AWS_ACCESS_KEY_ID= # Set to your AWS Access Key ID if using S3 for file storage
AWS_SECRET_ACCESS_KEY= # Set to your AWS Secret Access Key if using S3 for file storage
AWS_DEFAULT_REGION=us-east-1 # Set to your AWS region (e.g., us-east-1, us-west-2) if using S3
AWS_BUCKET=    # Set to your S3 bucket name if using S3 for file storage
AWS_USE_PATH_STYLE_ENDPOINT=false # Set to true if using a service that requires path-style endpoints (e.g., MinIO, some S3-compatible services) instead of virtual-hosted style (default for AWS S3)

# ============================================================================
# Frontend (Vite)
# ============================================================================
VITE_APP_NAME="${APP_NAME}"
